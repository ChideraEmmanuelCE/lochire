# Private backend configuration. Never commit real credentials.
SERVICE_SECRET=
APP_ORIGIN=https://lochire.vercel.app
APP_MODE=production
PAYMENT_MODE=live
PAYSTACK_MODE=live
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
# Set the webhook in Paystack: https://lochire.vercel.app/api/webhooks/paystack
# Hosted checkout needs no public key. This service creates direct settlements,
# not stored-value wallets, escrow, top-ups or manual withdrawals.
ADMIN_EMAILS=
ADMIN_USER_IDS=
RESEND_API_KEY=
EMAIL_FROM=
POSTCODE_ENABLED=false
POSTCODE_ENVIRONMENT=sandbox
POSTCODE_API_KEY=
POSTCODE_LOOKUP_LEVEL=2
POSTCODE_BASE_URL=https://api.postcode.gov.ng
# Kora notification inbox only. Keep disabled until a private secret is saved.
# Does not yet create virtual accounts, credit balances or pay workers.
KORAPAY_MODE=test
KORAPAY_WEBHOOKS_ENABLED=false
KORAPAY_SECRET_KEY=
KORAPAY_BUSINESS_APPROVED=false
# Optional: accept a test-only key from the service-authenticated Vercel gateway.
KORAPAY_ALLOW_TEST_KEY_RELAY=false
# Private simulated wallet. ADMIN_EMAILS can test; optionally add other testers.
KORAPAY_SANDBOX_WALLET_ENABLED=false
KORAPAY_TESTER_EMAILS=
