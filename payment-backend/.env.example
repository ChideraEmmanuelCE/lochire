# Configure production values in the private backend environment, not GitHub.
SERVICE_SECRET=
APP_ORIGIN=https://lochire.vercel.app
PAYMENT_MODE=sandbox
WEMA_MODE=demo
WEMA_ENABLED=false
WEMA_ENVIRONMENT=sandbox

# Wema supplies the base URL, API key and assigned channel.
WEMA_BASE_URL=
WEMA_API_KEY=
WEMA_CHANNEL_ID=
WEMA_CALLBACK_TOKEN=
WEMA_MANDATE_KEY=
WEMA_WALLET_VERIFY_PATH=
WEMA_TRANSFER_STATUS_PATH=
WEMA_AMOUNT_UNIT=naira
WEMA_BANK_CODE=035
WEMA_CONTRACT_CONFIRMED=false

# Optional NIPOST adapter. Keep disabled until the hackathon key is supplied.
POSTCODE_ENABLED=false
POSTCODE_ENVIRONMENT=sandbox
POSTCODE_API_KEY=
POSTCODE_LOOKUP_LEVEL=2
POSTCODE_BASE_URL=https://api.postcode.gov.ng

# Incoming bank-transfer deposits; activate only with approved bank contracts.
WEMA_DEPOSITS_ENABLED=false
WEMA_DEPOSIT_CONTRACT_CONFIRMED=false
WEMA_DEPOSIT_STATUS_PATH=
WEMA_BALANCE_PATH=
WEMA_AUTH_HEADER=x-api-key
