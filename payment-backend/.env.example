# Private backend configuration. Never commit real credentials.
SERVICE_SECRET=
APP_ORIGIN=https://lochire.ng
ALLOWED_APP_ORIGINS=https://lochire.vercel.app
APP_MODE=production
PAYMENT_MODE=live
PAYMENTS_PRODUCT=premium
PAYSTACK_MODE=live
PAYSTACK_PREMIUM_ENABLED=false
# Set privately here OR in the Vercel gateway with relay enabled below.
PAYSTACK_SECRET_KEY=
PAYSTACK_ALLOW_KEY_RELAY=false
# Test checkout is restricted to these account IDs/emails in test mode.
PAYSTACK_PREMIUM_TEST_USERS=
# Legacy salary/subaccount/credit product remains disabled.
PAYSTACK_ENABLED=false
# Webhook: https://lochire.ng/api/webhooks/paystack
ADMIN_EMAILS=
ADMIN_USER_IDS=
RESEND_API_KEY=
EMAIL_FROM=
POSTCODE_ENABLED=false
POSTCODE_ENVIRONMENT=sandbox
POSTCODE_API_KEY=
POSTCODE_LOOKUP_LEVEL=2
POSTCODE_BASE_URL=https://api.postcode.gov.ng
# Historical Kora orders only; no new Kora premium checkout.
KORAPAY_MODE=test
KORAPAY_PREMIUM_ENABLED=false
KORAPAY_WEBHOOKS_ENABLED=false
KORAPAY_SECRET_KEY=
KORAPAY_BUSINESS_APPROVED=false
KORAPAY_ALLOW_TEST_KEY_RELAY=false
KORAPAY_SANDBOX_WALLET_ENABLED=false
